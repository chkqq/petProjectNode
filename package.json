{
  "name": "pet-project-node",
  "version": "1.0.0",
  "description": "NestJS REST API for user profiles with PostgreSQL, JWT auth and Swagger",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "nest build",
    "db:down": "docker compose -f docker-compose.yml -f docker-compose.storage.yml down",
    "db:logs": "docker compose -f docker-compose.yml -f docker-compose.storage.yml logs -f postgres minio redis",
    "db:up": "docker compose -f docker-compose.yml -f docker-compose.storage.yml up -d",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"frontend/src/**/*.{ts,tsx}\"",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\" \"frontend/src/**/*.{ts,tsx}\"",
    "lint:fix": "eslint \"src/**/*.ts\" \"test/**/*.ts\" \"frontend/src/**/*.{ts,tsx}\" --fix",
    "lint:watch": "chokidar \"src/**/*.ts\" \"test/**/*.ts\" \"frontend/src/**/*.{ts,tsx}\" -c \"npm run lint\"",
    "migration:generate": "npm run typeorm -- -d src/database/data-source.ts migration:generate src/database/migrations/AutoMigration",
    "migration:revert": "npm run typeorm -- -d src/database/data-source.ts migration:revert",
    "migration:run": "npm run typeorm -- -d src/database/data-source.ts migration:run",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "frontend:install": "npm --prefix frontend install",
    "frontend:dev": "npm --prefix frontend run dev",
    "frontend:build": "npm --prefix frontend run build",
    "frontend:preview": "npm --prefix frontend run preview",
    "test": "jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json --runInBand",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "typeorm": "node --require ts-node/register --require tsconfig-paths/register ./node_modules/typeorm/cli.js",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix"
    ]
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1092.0",
    "@nestjs/bull": "^11.0.4",
    "@nestjs/common": "^11.1.28",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.28",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.28",
    "@nestjs/swagger": "^11.4.5",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/typeorm": "^11.0.3",
    "bcryptjs": "^2.4.3",
    "bull": "^4.16.5",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^17.4.2",
    "helmet": "^8.3.0",
    "ioredis": "^5.11.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.20",
    "typeorm-transactional": "^0.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.1.28",
    "@types/bull": "^3.15.9",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.10.2",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.38",
    "@types/supertest": "^6.0.2",
    "chokidar-cli": "^3.0.0",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "lint-staged": "^17.1.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.65.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
